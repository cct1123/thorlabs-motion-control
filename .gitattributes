# Keep source files consistent across Windows, Linux, and macOS.
* text=auto eol=lf

# Windows command scripts require CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve binary reference documents and media byte for byte.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.whl binary
*.gz binary
